@model DashboardModel
@using Vtb.Hr.Web.Services
@{ViewData["Title"]=ViewContext.RouteData.Values["controller"]?.ToString()=="Quality"?"Tổng quan chất lượng":"Tổng quan hệ thống";var filters=new GridModel{Filter=Model.Filter,Options=Model.Options,Filters=["DivisionId","DepartmentId"]};var denominator=Model.Complete+Model.Missing;var rate=denominator==0?0:100d*Model.Complete/denominator;}
<h1 class="page-title mb-4">@ViewData["Title"]</h1>
<div class="card mb-4"><div class="card-body"><partial name="_Filters" model="filters"/></div></div>
<div class="row row-cards mb-4">
@foreach(var kpi in new[]{("Tổng số cán bộ",Model.Employees,"blue"),("Tổng tài liệu (gồm lịch sử)",Model.Documents,"blue"),("Cán bộ hồ sơ đầy đủ",Model.Complete,"green"),("Cán bộ thiếu hồ sơ",Model.Missing,"red"),("Tài liệu hết hạn",Model.Expired,"red"),("Tài liệu sắp hết hạn",Model.Expiring,"yellow"),("Tài liệu không hợp lệ",Model.Invalid,"red")}){
<div class="col-sm-6 col-xl-3"><div class="card h-100"><div class="card-body"><div class="text-secondary mb-3">@kpi.Item1</div><div class="metric text-@kpi.Item3">@kpi.Item2.ToString("N0")</div></div></div></div>}
</div>
@if(Model.QualityRows!=Model.QualityDocuments||Model.Conflicts>0){<div class="alert alert-warning">View có @Model.QualityRows dòng cho @Model.QualityDocuments tài liệu hiện hành; @Model.Conflicts tài liệu có nhiều trạng thái. KPI đếm tài liệu phân biệt trong từng trạng thái, nên không cộng các nhóm thành tổng. Cần rà soát quy tắc trước khi kết luận chất lượng.</div>}
<div class="row row-cards mb-4"><div class="col-lg-5"><div class="card h-100"><div class="card-body"><h2 class="card-title">Mức độ đầy đủ hồ sơ</h2><div class="metric my-3">@(denominator==0?"Chưa có dữ liệu":rate.ToString("0.0")+"%")</div><div class="progress mb-3" aria-label="Tỷ lệ hồ sơ đầy đủ"><div class="progress-bar bg-green" style="width:@rate.ToString("0.##",System.Globalization.CultureInfo.InvariantCulture)%"></div></div><p class="text-secondary">@Model.Complete đầy đủ / @denominator cán bộ có kết quả trong View. Đầy đủ không đồng nghĩa mọi tài liệu đều hợp lệ.</p></div></div></div>
<div class="col-lg-7"><div class="card h-100"><div class="card-body"><h2 class="card-title">Phân bố chất lượng tài liệu</h2>@foreach(var item in new[]{("Hợp lệ",Model.Valid,"green"),("Sắp hết hạn",Model.Expiring,"yellow"),("Hết hạn",Model.Expired,"red"),("Không hợp lệ",Model.Invalid,"orange")}){var width=Model.QualityDocuments==0?0:100d*item.Item2/Model.QualityDocuments;<div class="d-flex justify-content-between mt-3"><span>@item.Item1</span><strong>@item.Item2</strong></div><div class="progress mt-1"><div class="progress-bar bg-@item.Item3" style="width:@width.ToString("0.##",System.Globalization.CultureInfo.InvariantCulture)%"></div></div>}</div></div></div></div>
<div class="card"><div class="card-header"><h2 class="card-title">Hồ sơ cần bổ sung</h2><a asp-controller="Quality" asp-action="List" asp-route-kind="employees" asp-route-status="THIEU_HO_SO" asp-route-divisionId="@Model.Filter.DivisionId" asp-route-departmentId="@Model.Filter.DepartmentId" asp-route-kpiOnly="@Model.Filter.KpiOnly" class="ms-auto">Xem danh sách →</a></div><div class="table-responsive"><table class="table"><thead><tr><th>Cán bộ</th><th>Còn thiếu</th><th>Cảnh báo</th><th></th></tr></thead><tbody>@foreach(var item in Model.Alerts){<tr><td>@item.FullName <span class="text-secondary">@item.EmployeeId</span></td><td>@item.TotalDocumentsMissing</td><td>@item.QualityIssue</td><td><a asp-controller="Profiles" asp-action="Details" asp-route-id="@item.EmployeeId">Xem hồ sơ</a></td></tr>}@if(Model.Alerts.Count==0){<tr><td colspan="4" class="text-center text-secondary py-4">Không có cảnh báo thiếu hồ sơ trong phạm vi đã chọn.</td></tr>}</tbody></table></div></div>


