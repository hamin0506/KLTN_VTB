@model GridModel
@using Vtb.Hr.Web.Services
@using Vtb.Hr.Web.Security
@inject IConfiguration Config
@{var filtered=Model.Filter.Routes().Any(x=>x.Key is not ("kind" or "kpiOnly")&&!string.IsNullOrWhiteSpace(x.Value))||Model.Filter.KpiOnly;var numericHeaders=new[]{"Yêu cầu","Đã có","Còn thiếu","Ngưỡng cảnh báo (ngày)","Số ngày còn lại","Còn (ngày)"};ViewData["Title"]=Model.Title;var admin=Access.Admin(User,Config);var employeeGrid=Model.Kind=="employees"&&ViewContext.RouteData.Values["controller"]?.ToString()=="Catalog";var columns=employeeGrid?new[]{"Mã cán bộ","Họ và tên","Số điện thoại","Email","Giới tính","Phòng ban","Chức danh","Trạng thái làm việc"}.Select(label=>Array.IndexOf(Model.Headers,label)).Where(index=>index>=0).ToArray():Enumerable.Range(0,Model.Headers.Length).ToArray();}
<div class="page-header mb-4"><div class="row align-items-center"><div class="col"><h1 class="page-title">@Model.Title</h1></div>@if(Model.Create is {} create&&admin){<div class="col-auto"><a class="btn btn-primary" asp-controller="@create.Controller" asp-action="@create.Action" asp-route-kind="@create.Kind" asp-route-employeeId="@Model.Filter.EmployeeId" asp-route-returnUrl="@NavigationContext.Current(Context.Request)">+ @create.Label</a></div>}</div></div>
@if(Model.Note!=null){<div class="alert alert-info">@Model.Note</div>}
<div class="card mb-4"><div class="card-body"><partial name="_Filters" model="Model"/></div></div>
<div class="card @(employeeGrid?"employee-results-card":"")"><div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-3 export-card-header"><h2 class="card-title">Kết quả</h2><div class="export-header-actions d-flex align-items-center justify-content-end flex-wrap gap-2 ms-auto">
@if(ViewContext.RouteData.Values["controller"]?.ToString()=="Catalog"&&Model.Kind=="employees"){
<button type="button" class="btn btn-sm btn-outline-primary export-button" data-employee-export data-employment-labels="@System.Text.Json.JsonSerializer.Serialize(Labels.Employment)">Xuất danh sách cán bộ</button>
}else{<button type="button" class="btn btn-sm btn-outline-primary export-button" data-export-url="@Url.Action(ViewContext.RouteData.Values["controller"]?.ToString()=="Quality"?"Quality":"Catalog","Export",new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.Filter.Routes(Model.Kind).ToDictionary(x=>x.Key,x=>(object?)x.Value)))">Xuất Excel</button>}
<span class="badge bg-blue-lt">@Model.Total dòng</span></div></div>
@if(employeeGrid){<partial name="~/Views/Shared/_EmployeeQualityLegend.cshtml" model="Model"/>}
@if(Model.Rows.Count==0){<div class="empty p-5"><div class="empty-icon">⌕</div><p class="empty-title">@(filtered?"Không có kết quả phù hợp":"Chưa có dữ liệu trong danh sách")</p><p class="empty-subtitle text-secondary">@(filtered?"Thử thay đổi từ khóa hoặc bộ lọc đang áp dụng.":"Chưa có bản ghi được trả về. Liên hệ người quản trị nếu bạn cần kiểm tra dữ liệu.")</p></div>}else{
<div class="table-responsive @(employeeGrid?"employee-table-scroll":"")" tabindex="0" aria-label="Bảng kết quả"><table class="table table-vcenter mb-0 @(employeeGrid?"employee-table":"")">@if(employeeGrid){<colgroup><col class="employee-code-col"/><col class="employee-name-col"/><col class="employee-phone-col"/><col class="employee-email-col"/><col class="employee-gender-col"/><col class="employee-department-col"/><col class="employee-position-col"/><col class="employee-status-col"/><col class="employee-action-col"/></colgroup>}<thead><tr>@foreach(var column in columns){<th scope="col" class="@(numericHeaders.Contains(Model.Headers[column])?"ui-number":null)">@Model.Headers[column]</th>}<th class="@(employeeGrid?"employee-actions-cell":"")">Thao tác</th></tr></thead><tbody>
@foreach(var row in Model.Rows){<tr>@foreach(var column in columns){var cell=row.Cells[column];<td data-label="@(employeeGrid?Model.Headers[column]:null)" class="@(numericHeaders.Contains(Model.Headers[column])?"ui-number":null)">@if(employeeGrid&&Model.Headers[column]=="Mã cán bộ"){var indicator=row.QualityIndicator??EmployeeQualityIndicator.Unknown;<a class="employee-quality-link" asp-controller="Profiles" asp-action="Details" asp-route-id="@cell" asp-route-returnUrl="@NavigationContext.Current(Context.Request)" title="@indicator.Tooltip"><span>@cell</span></a><div class="employee-quality-caption"><partial name="~/Views/Shared/_EmployeeQualityDot.cshtml" model="indicator"/><span>@indicator.Label</span></div>}else if(employeeGrid&&Model.Headers[column]=="Trạng thái làm việc"){var employmentCode=Labels.Employment.FirstOrDefault(x=>x.Key==cell||x.Value==cell).Key;<span class="badge employee-employment-badge employee-employment--@employmentCode">@(string.IsNullOrWhiteSpace(cell)?"--":Labels.Text(cell))</span>}else if(employeeGrid&&Model.Headers[column]=="Giới tính"){@(string.IsNullOrWhiteSpace(cell)?"--":Labels.Text(cell))}else if(employeeGrid&&Model.Headers[column]=="Phòng ban"){<span class="employee-department-text" title="@cell">@(string.IsNullOrWhiteSpace(cell)?"--":cell)</span>}else if(cell!=null&&Labels.All.ContainsKey(cell)){<span class="badge bg-@Labels.Color(cell)-lt">@Labels.Text(cell)</span>}else{@(string.IsNullOrWhiteSpace(cell)?"—":cell)}</td>}<td data-label="@(employeeGrid?"Thao tác":null)" class="@(employeeGrid?"employee-actions-cell":"")"><div class="table-row-actions">@foreach(var link in row.Links){if(!admin&&(link.Action is "Create" or "Edit" or "Delete")){continue;}<a title="@link.Label" aria-label="@link.Label" class="@(link.Action=="Delete"?"text-danger":link.Controller=="Profiles"?"table-row-action-primary":null)" asp-controller="@link.Controller" asp-action="@link.Action" asp-route-id="@link.Id" asp-route-kind="@link.Kind" asp-route-employeeId="@link.EmployeeId" asp-route-documentTypeId="@link.DocumentTypeId" asp-route-returnUrl="@NavigationContext.Current(Context.Request)">@link.Label</a>}</div></td></tr>}
</tbody></table></div>}
<div class="card-footer d-flex justify-content-between align-items-center"><span>Trang @Model.Filter.Page / @Model.Pages</span><div class="btn-group">@if(Model.Filter.Page>1){<a class="btn" asp-all-route-data="Model.Filter.Routes(Model.Kind)" asp-route-page="@(Model.Filter.Page-1)">← Trước</a>}@if(Model.Filter.Page<Model.Pages){<a class="btn" asp-all-route-data="Model.Filter.Routes(Model.Kind)" asp-route-page="@(Model.Filter.Page+1)">Sau →</a>}</div></div></div>


