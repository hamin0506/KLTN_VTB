@model GridModel
@using Vtb.Hr.Web.Services
@using Vtb.Hr.Web.Security
@inject IConfiguration Config
@{ViewData["Title"]=Model.Title;var admin=Access.Admin(User,Config);var employeeGrid=Model.Kind=="employees";var columns=employeeGrid?new[]{"Mã cán bộ","Họ và tên","Số điện thoại","Email","Giới tính","Phòng ban"}.Select(label=>Array.IndexOf(Model.Headers,label)).Where(index=>index>=0).ToArray():Enumerable.Range(0,Model.Headers.Length).ToArray();}
<div class="page-header mb-4"><div class="row align-items-center"><div class="col"><h1 class="page-title">@Model.Title</h1></div>@if(Model.Create is {} create&&admin){<div class="col-auto"><a class="btn btn-primary" asp-controller="@create.Controller" asp-action="@create.Action" asp-route-kind="@create.Kind">+ @create.Label</a></div>}</div></div>
@if(Model.Note!=null){<div class="alert alert-info">@Model.Note</div>}
<div class="card mb-4"><div class="card-body"><partial name="_Filters" model="Model"/></div></div>
<div class="card"><div class="card-header"><h2 class="card-title">Kết quả</h2><span class="badge bg-blue-lt ms-auto">@Model.Total dòng</span></div>
@if(Model.Rows.Count==0){<div class="empty p-5"><div class="empty-icon">⌕</div><p class="empty-title">Không có kết quả phù hợp</p><p class="empty-subtitle text-secondary">Thử thay đổi bộ lọc hoặc bổ sung dữ liệu nếu bạn có quyền quản trị.</p></div>}else{
<div class="table-responsive @(employeeGrid?"employee-table-scroll":"")" tabindex="0" aria-label="Bảng kết quả"><table class="table table-vcenter mb-0 @(employeeGrid?"employee-table":"")">@if(employeeGrid){<colgroup><col class="employee-code-col"/><col class="employee-name-col"/><col class="employee-phone-col"/><col class="employee-email-col"/><col class="employee-gender-col"/><col class="employee-department-col"/><col class="employee-action-col"/></colgroup>}<thead><tr>@foreach(var column in columns){<th>@Model.Headers[column]</th>}<th class="@(employeeGrid?"employee-actions-cell":"")">Thao tác</th></tr></thead><tbody>
@foreach(var row in Model.Rows){<tr>@foreach(var column in columns){var cell=row.Cells[column];<td>@if(cell!=null&&Labels.All.ContainsKey(cell)){<span class="badge bg-@Labels.Color(cell)-lt">@Labels.Text(cell)</span>}else{@(string.IsNullOrWhiteSpace(cell)?"—":cell)}</td>}<td class="@(employeeGrid?"employee-actions-cell":"")"><div class="d-flex gap-2 @(employeeGrid?"employee-actions":"flex-wrap")">@foreach(var link in row.Links){if(!admin&&(link.Action is "Create" or "Edit" or "Delete")){continue;}<a title="@link.Label" aria-label="@link.Label" class="@(employeeGrid?(link.Action=="Delete"?"employee-action text-danger":"employee-action text-primary"):(link.Action=="Delete"?"btn btn-sm btn-outline-danger":"btn btn-sm btn-outline-primary"))" asp-controller="@link.Controller" asp-action="@link.Action" asp-route-id="@link.Id" asp-route-kind="@link.Kind" asp-route-employeeId="@link.EmployeeId" asp-route-documentTypeId="@link.DocumentTypeId">@link.Label</a>}</div></td></tr>}
</tbody></table></div>}
<div class="card-footer d-flex justify-content-between align-items-center"><span>Trang @Model.Filter.Page / @Model.Pages</span><div class="btn-group">@if(Model.Filter.Page>1){<a class="btn" asp-all-route-data="Model.Filter.Routes(Model.Kind)" asp-route-page="@(Model.Filter.Page-1)">← Trước</a>}@if(Model.Filter.Page<Model.Pages){<a class="btn" asp-all-route-data="Model.Filter.Routes(Model.Kind)" asp-route-page="@(Model.Filter.Page+1)">Sau →</a>}</div></div></div>


