@using Vtb.Hr.Web.Security
@inject IConfiguration Config
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostEnvironment
@{
 var controller=ViewContext.RouteData.Values["controller"]?.ToString();var action=ViewContext.RouteData.Values["action"]?.ToString();var kind=Context.Request.Query["kind"].ToString();
 var groups=new (string Title,string Icon,(string Label,string Controller,string Action,string Kind)[] Links)[]{
 ("Quản lý tổ chức","building",[("Đơn vị","Divisions","Index",""),("Phòng ban","Departments","Index","")])};
}
<!DOCTYPE html><html lang="vi"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] · Quản lý hồ sơ cán bộ</title><link rel="stylesheet" href="~/lib/tabler/tabler.min.css"/><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/workspace-layout.css" asp-append-version="true"/></head>
<body><a href="#main-content" class="visually-hidden-focusable">Đến nội dung chính</a><div class="page"><aside id="app-sidebar" class="navbar navbar-vertical navbar-expand-lg" data-bs-theme="dark"><div class="container-fluid sidebar-brand-layout"><div class="sidebar-toolbar"><button id="sidebar-toggle" class="btn btn-icon sidebar-panel-toggle" type="button" aria-controls="app-sidebar" aria-expanded="true" aria-label="Thu gọn thanh bên" title="Thu gọn thanh bên"><svg class="menu-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 3v18m7-13-4 4 4 4"/></svg></button></div><a class="navbar-brand app-brand" asp-controller="Dashboard" asp-action="Index">@if(HostEnvironment.WebRootFileProvider.GetFileInfo("images/Vietinbank_logo.png").Exists){<span class="brand-logo-surface"><svg class="brand-logo" viewBox="68 91 913 249" role="img" aria-label="VietinBank" preserveAspectRatio="xMidYMid meet"><image href="@Url.Content("~/images/Vietinbank_logo.png")" width="1067" height="402" /></svg></span>}<span class="brand-title">Quản lý hồ sơ cán bộ</span></a><button class="btn sidebar-close" type="button" aria-label="Đóng thanh menu">×</button><div class="navbar-collapse" id="sidebar"><nav aria-label="Điều hướng chính" class="w-100">
<a title="Báo cáo trực quan" aria-label="Báo cáo trực quan" class="nav-link @(controller=="Dashboard"?"active":"")" asp-controller="Dashboard" asp-action="Index"><svg class="menu-icon" aria-hidden="true"><use href="/icons.svg#chart"/></svg><span class="nav-label">Báo cáo trực quan</span></a>
@foreach(var group in groups){var opened=group.Links.Any(l=>l.Controller==controller&&(string.IsNullOrEmpty(l.Kind)||l.Kind==kind));<details class="nav-group" open="@opened"><summary title="@group.Title" aria-label="@group.Title" aria-expanded="@(opened ? "true" : "false")" aria-controls="organization-submenu"><svg class="menu-icon" aria-hidden="true"><use href="/icons.svg#@group.Icon"/></svg><span class="nav-label">@group.Title</span><svg class="menu-chevron" aria-hidden="true"><use href="/icons.svg#chevron-right"/></svg></summary><div class="nav-submenu" id="organization-submenu">@foreach(var link in group.Links){var active=controller==link.Controller&&(link.Kind==kind)&&(controller!="Quality"||action==link.Action);<a class="nav-link @(active?"active":"")" asp-controller="@link.Controller" asp-action="@link.Action" asp-route-kind="@(string.IsNullOrEmpty(link.Kind)?null:link.Kind)" aria-current="@(active?"page":null)">@link.Label</a>}</div></details>}
<a title="Danh sách cán bộ" aria-label="Danh sách cán bộ" class="nav-link @(controller=="Catalog"&&kind=="employees"||controller=="Profiles"?"active":"")" asp-controller="Catalog" asp-action="Index" asp-route-kind="employees"><svg class="menu-icon" aria-hidden="true"><use href="/icons.svg#users"/></svg><span class="nav-label">Danh sách cán bộ</span></a>
<a title="Danh sách loại tài liệu" aria-label="Danh sách loại tài liệu" class="nav-link @(controller=="Catalog"&&(kind=="documents"||kind=="types")?"active":"")" asp-controller="Catalog" asp-action="Index" asp-route-kind="types"><svg class="menu-icon" aria-hidden="true"><use href="/icons.svg#file"/></svg><span class="nav-label">Danh sách loại tài liệu</span></a>
<a title="Chất lượng dữ liệu" aria-label="Chất lượng dữ liệu" class="nav-link @(controller=="Catalog"&&kind=="rules"?"active":"")" asp-controller="Catalog" asp-action="Index" asp-route-kind="rules"><svg class="menu-icon" aria-hidden="true"><use href="/icons.svg#chart"/></svg><span class="nav-label">Chất lượng dữ liệu</span></a>
</nav><div class="sidebar-note"><a title="Kết nối hệ thống" aria-label="Kết nối hệ thống" asp-controller="Home" asp-action="Setup"><svg class="menu-icon" aria-hidden="true"><use href="/icons.svg#settings"/></svg><span class="nav-label">Kết nối hệ thống</span></a></div></div></div></aside>
<button class="sidebar-backdrop" type="button" aria-label="Đóng thanh menu" hidden></button><div class="page-wrapper"><header class="navbar topbar"><div class="container-fluid px-3 px-lg-4"><button id="sidebar-mobile-toggle" class="btn btn-icon" type="button" aria-controls="app-sidebar" aria-expanded="false" aria-label="Mở thanh menu" title="Mở thanh menu"><svg class="menu-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 3v18m7-13-4 4 4 4"/></svg></button><div class="ms-auto d-flex align-items-center gap-2"><span class="badge bg-blue-lt">@(Access.Admin(User,Config)?"Quản trị":User.Identity?.IsAuthenticated==true?"Chỉ xem":"Chưa đăng nhập")</span><span class="small text-secondary">@User.Identity?.Name</span></div></div></header>
<main id="main-content" class="page-body"><div class="@((controller=="Dashboard"||(controller=="Catalog"&&kind=="employees"&&action=="Index"))?"container-fluid px-3 px-lg-4":"container-xl")"><nav aria-label="Đường dẫn"><ol class="breadcrumb mb-4"><li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Trang chủ</a></li><li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]</li></ol></nav>
@if(TempData["Success"] is string success){<div class="alert alert-success" role="status">@success</div>}@if(TempData["Error"] is string error){<div class="alert alert-danger" role="alert">@error</div>}
@RenderBody()</div></main></div></div><script src="~/lib/tabler/tabler.min.js"></script><script src="~/lib/jquery/dist/jquery.min.js"></script><script src="~/js/site.js" asp-append-version="true"></script><script src="~/js/sidebar.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts",required:false)</body></html>


