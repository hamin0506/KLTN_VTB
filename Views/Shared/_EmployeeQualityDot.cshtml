@model EmployeeQualityIndicator
@if(Model.State is "success" or "error"){
<span class="employee-quality-dot employee-quality-dot--@Model.State" role="img" aria-label="@Model.Tooltip" title="@Model.Tooltip"></span>
}else{
<span class="employee-quality-unavailable" title="@Model.Tooltip" aria-label="@Model.Tooltip">--</span>
}
