@model Vtb.Hr.Web.Data.Document
@inject Vtb.Hr.Web.Services.DocumentFileStore Files
@if(Files.Exists(Model.FilePath)){
<a class="document-file-eye" asp-controller="DocumentFiles" asp-action="Open" asp-route-id="@Model.DocumentId" target="_blank" rel="noopener" title="Xem tệp đính kèm" aria-label="Xem tệp đính kèm"><svg class="document-eye-icon" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg></a>
}else{
<span class="document-file-eye-disabled" title="Chưa có tệp đính kèm"><button type="button" class="document-file-eye" disabled aria-label="Chưa có tệp đính kèm"><svg class="document-eye-icon" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg></button></span>
}
