@model DivisionList
@{ViewData["Title"]="Đơn vị tổ chức";}
<div class="page-header mb-4"><div class="row align-items-center"><div class="col"><h1 class="page-title">Đơn vị tổ chức</h1></div><div class="col-auto"><a class="btn btn-primary" asp-action="Create">+ Thêm đơn vị</a></div></div></div>
<div class="card"><div class="card-header flex-wrap gap-3"><h3 class="card-title">Danh sách đơn vị <span class="badge bg-blue-lt ms-2">@Model.Total</span></h3><form method="get" class="ms-auto d-flex gap-2"><label for="q" class="visually-hidden">Tìm mã hoặc tên đơn vị</label><input class="form-control" id="q" name="q" value="@Model.Q" placeholder="Tìm mã hoặc tên đơn vị…" maxlength="200"/><button class="btn btn-outline-primary" type="submit">Tìm kiếm</button>@if(!string.IsNullOrEmpty(Model.Q)){<a class="btn" asp-action="Index">Bỏ lọc</a>}</form></div>
@if(Model.Items.Count==0){<div class="text-center p-5"><div class="empty-icon">▦</div><h3 class="mt-3">@(string.IsNullOrEmpty(Model.Q)?"Chưa có đơn vị":"Không tìm thấy đơn vị")</h3><p class="text-secondary">Thêm đơn vị mới hoặc thử từ khóa tìm kiếm khác.</p></div>}else{<div class="table-responsive"><table class="table table-vcenter mb-0"><thead><tr><th>Mã đơn vị</th><th>Tên đơn vị</th><th class="text-end">Thao tác</th></tr></thead><tbody>@foreach(var item in Model.Items){<tr><td><span class="badge bg-blue-lt">@item.DivisionCode</span></td><td><a class="fw-semibold" asp-action="Details" asp-route-id="@item.DivisionId">@item.DivisionName</a></td><td class="text-end"><a class="btn btn-sm" asp-action="Edit" asp-route-id="@item.DivisionId">Chỉnh sửa</a> <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.DivisionId">Xóa</a></td></tr>}</tbody></table></div>}
<div class="card-footer d-flex justify-content-between align-items-center"><span class="text-secondary">Trang @Model.Page / @Model.Pages · @Model.Total đơn vị</span><div class="btn-group">@if(Model.Page>1){<a class="btn" asp-route-page="@(Model.Page-1)" asp-route-q="@Model.Q">← Trước</a>}@if(Model.Page<Model.Pages){<a class="btn" asp-route-page="@(Model.Page+1)" asp-route-q="@Model.Q">Sau →</a>}</div></div></div>
