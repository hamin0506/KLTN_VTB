@model DivisionList
@using Vtb.Hr.Web.Security
@using Vtb.Hr.Web.Services
@inject IConfiguration Config
@{var admin=Access.Admin(User,Config);ViewData["Title"]="Khối tổ chức";}
<div class="page-header mb-4"><div class="row align-items-center"><div class="col"><h1 class="page-title">Khối tổ chức</h1></div><div class="col-auto">@if(admin){<a class="btn btn-primary" asp-action="Create" asp-route-returnUrl="@NavigationContext.Current(Context.Request)">+ Thêm khối</a>}</div></div></div>
<div class="card"><div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-3 export-card-header"><h3 class="card-title">Danh sách khối</h3><div class="export-header-actions d-flex align-items-center justify-content-end flex-wrap gap-2 ms-auto"><button type="button" class="btn btn-sm btn-outline-primary export-button" data-export-url="@Url.Action("Organization","Export",new{kind="divisions",q=Model.Q})">Xuất Excel</button><span class="badge bg-blue-lt">@Model.Total dòng</span></div></div><div class="card-body border-bottom"><form method="get" class="d-flex align-items-end gap-3 flex-wrap"><div class="ui-filter-field"><label for="q" class="form-label">Tìm mã hoặc tên khối</label><input class="form-control" id="q" name="q" value="@Model.Q" placeholder="Tìm mã hoặc tên khối…" maxlength="200"/></div><button class="btn btn-primary" type="submit">Tìm</button>@if(!string.IsNullOrEmpty(Model.Q)){<a class="btn btn-outline-secondary" asp-action="Index">Xóa bộ lọc</a>}</form></div>
@if(Model.Items.Count==0){<div class="text-center p-5"><div class="empty-icon">▦</div><h3 class="mt-3">@(string.IsNullOrEmpty(Model.Q)?"Chưa có khối":"Không tìm thấy khối")</h3><p class="text-secondary">@(admin?"Thêm khối mới hoặc thử từ khóa tìm kiếm khác.":"Thử từ khóa khác hoặc liên hệ người quản trị nếu cần bổ sung khối.")</p></div>}else{<div class="table-responsive"><table class="table table-vcenter mb-0"><thead><tr><th>Mã khối</th><th>Tên khối</th><th class="text-end">Thao tác</th></tr></thead><tbody>@foreach(var item in Model.Items){<tr><td><span class="badge bg-blue-lt">@item.DivisionCode</span></td><td><a class="fw-semibold" asp-action="Details" asp-route-returnUrl="@NavigationContext.Current(Context.Request)" asp-route-id="@item.DivisionId">@item.DivisionName</a></td><td class="text-end"><div class="table-row-actions">@if(admin){<a asp-action="Edit" asp-route-returnUrl="@NavigationContext.Current(Context.Request)" asp-route-id="@item.DivisionId">Chỉnh sửa</a>} @if(admin){<a class="text-danger" asp-action="Delete" asp-route-id="@item.DivisionId">Xóa</a>}</div></td></tr>}</tbody></table></div>}
<div class="card-footer d-flex justify-content-between align-items-center"><span class="text-secondary">Trang @Model.Page / @Model.Pages · @Model.Total khối</span><div class="btn-group">@if(Model.Page>1){<a class="btn" asp-route-page="@(Model.Page-1)" asp-route-q="@Model.Q">← Trước</a>}@if(Model.Page<Model.Pages){<a class="btn" asp-route-page="@(Model.Page+1)" asp-route-q="@Model.Q">Sau →</a>}</div></div></div>
