@using Vtb.Hr.Web.Services
@model DivisionForm
@{bool edit=Model.DivisionId>0;ViewData["Title"]=edit?"Chỉnh sửa khối":"Thêm khối";}
<h1 class="page-title mb-4">@ViewData["Title"]</h1><div class="row row-cards"><div class="col-lg-8"><form class="card ui-form" asp-action="@(edit?"Edit":"Create")" asp-route-id="@(edit?Model.DivisionId:(int?)null)" method="post"><input type="hidden" name="returnUrl" value="@NavigationContext.OrganizationReturn(Context.Request, "Divisions")"/><div class="card-header"><h3 class="card-title">Thông tin khối</h3></div><div class="card-body"><p class="form-hint mb-3">Các trường có dấu * là bắt buộc.</p><div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert" tabindex="-1"></div><input asp-for="DivisionId" type="hidden"/><div class="mb-4"><label asp-for="DivisionCode" class="form-label required"></label><input asp-for="DivisionCode" class="form-control" maxlength="20" placeholder="Ví dụ: KHCN"/><span asp-validation-for="DivisionCode" class="text-danger"></span><div class="form-hint">Tối đa 20 ký tự ASCII, không chứa khoảng trắng.</div></div><div class="mb-3"><label asp-for="DivisionName" class="form-label required"></label><input asp-for="DivisionName" class="form-control" maxlength="200" placeholder="Nhập tên đầy đủ của khối"/><span asp-validation-for="DivisionName" class="text-danger"></span></div></div><div class="card-footer ui-form-actions"><a class="btn btn-outline-secondary" href="@(NavigationContext.OrganizationReturn(Context.Request,"Divisions")??Url.Action("Index","Divisions"))">Hủy</a><button type="submit" class="btn btn-primary">Lưu</button></div></form></div></div>
@section Scripts{<partial name="_ValidationScriptsPartial"/>}
