@model DivisionForm
@{bool edit=Model.DivisionId>0;ViewData["Title"]=edit?"Chỉnh sửa đơn vị":"Thêm đơn vị";}
<h1 class="page-title mb-4">@ViewData["Title"]</h1><div class="row row-cards"><div class="col-lg-8"><form class="card" asp-action="@(edit?"Edit":"Create")" asp-route-id="@(edit?Model.DivisionId:(int?)null)" method="post"><div class="card-header"><h3 class="card-title">Thông tin đơn vị</h3></div><div class="card-body"><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><input asp-for="DivisionId" type="hidden"/><div class="mb-4"><label asp-for="DivisionCode" class="form-label required"></label><input asp-for="DivisionCode" class="form-control" maxlength="20" placeholder="Ví dụ: KHCN"/><span asp-validation-for="DivisionCode" class="text-danger"></span><div class="form-hint">Tối đa 20 ký tự ASCII, không chứa khoảng trắng.</div></div><div class="mb-3"><label asp-for="DivisionName" class="form-label required"></label><input asp-for="DivisionName" class="form-control" maxlength="200" placeholder="Nhập tên đầy đủ của đơn vị"/><span asp-validation-for="DivisionName" class="text-danger"></span></div></div><div class="card-footer text-end"><a class="btn me-2" asp-action="Index">Hủy</a><button type="submit" class="btn btn-primary">Lưu đơn vị</button></div></form></div></div>
@section Scripts{<partial name="_ValidationScriptsPartial"/>}
