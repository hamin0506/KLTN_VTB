@model Vtb.Hr.Web.Data.Division
@{ViewData["Title"]="Xác nhận xóa khối";}
<h1 class="page-title mb-4">Xác nhận xóa khối</h1><div class="card"><div class="card-body"><div class="alert alert-warning">Thao tác xóa không thể hoàn tác. Khối có phòng ban trực thuộc sẽ không được xóa.</div><h2>@Model.DivisionName</h2><p class="text-secondary">Mã khối: @Model.DivisionCode</p></div><form class="card-footer ui-form-actions" asp-action="Delete" asp-route-id="@Model.DivisionId" method="post"><a class="btn btn-outline-secondary" asp-action="Index">Hủy</a><button class="btn btn-danger" type="submit">Xác nhận xóa</button></form></div>
