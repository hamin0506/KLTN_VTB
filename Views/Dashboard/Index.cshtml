@{ ViewData["Title"]="Báo cáo trực quan"; }
<link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
<section id="executive-overview" data-overview-url="@Url.Action("Data")" data-options-url="@Url.Action("Options")" data-missing-url="@Url.Action("Missing")" data-drill-url="@Url.Action("DocumentDetails")">
<div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-3"><div><h1 class="page-title">Báo cáo trực quan</h1></div><button class="btn btn-outline-primary" id="refresh-overview" type="button">Làm mới</button></div>
<partial name="_ReportTabs" />
<div class="card mb-3"><div class="card-body"><form id="overview-filters"><div class="row g-3 align-items-end">
<div class="col-12 col-md-4"><label for="status-filter" class="form-label">Trạng thái nhân viên</label><select id="status-filter" name="Statuses" multiple class="form-select" data-multi-filter data-placeholder="Tất cả trạng thái"><option value="DangLamViec" selected>Đang làm việc</option><option value="TamHoanHDLD" selected>Tạm hoãn HĐLĐ</option></select></div>
<div class="col-12 col-md-3"><label for="division-filter" class="form-label">Đơn vị</label><select id="division-filter" name="DivisionIds" multiple class="form-select" data-multi-filter data-placeholder="Chọn đơn vị"></select></div>
<div class="col-12 col-md-3"><label for="department-filter" class="form-label">Phòng ban</label><select id="department-filter" name="DepartmentIds" multiple class="form-select" data-multi-filter data-placeholder="Chọn phòng ban"></select></div>
<div class="col-12 col-md-2"><button type="button" id="clear-filters" class="btn w-100">Xóa bộ lọc</button></div>
</div><div class="form-hint mt-2">Bộ lọc tự động cập nhật. Không chọn đơn vị hoặc phòng ban nghĩa là tất cả.</div></form></div></div>
<div id="overview-error" class="alert alert-danger" role="alert" hidden></div><div id="overview-status" class="text-secondary mb-3" role="status" aria-live="polite">Đang tải dữ liệu…</div>
<div id="overview-results" aria-busy="true">
<div class="dashboard-kpi-grid">
@foreach(var k in new[]{("totalEmployees","Tổng nhân viên","total"),("completenessRate","Tỷ lệ nhân viên đủ hồ sơ","complete"),("missingEmployees","Nhân viên thiếu hồ sơ","missing"),("expiringDocuments","Tài liệu sắp hết hạn","expiring"),("expiredDocuments","Tài liệu đã hết hạn","expired"),("invalidDocuments","Tài liệu không hợp lệ","invalid")})
{
    <div class="dashboard-kpi-card">
        <div class="dashboard-kpi-label">@k.Item2</div>
        <div class="dashboard-kpi-value dashboard-kpi-value--@k.Item3" data-kpi="@k.Item1">—</div>
    </div>
}
</div>
<div class="dashboard-overview-layout">
<div class="dashboard-overview-left"><div class="card"><div class="card-header d-block"><h2 class="card-title">Tổng nhân viên</h2><div class="text-secondary small mt-1">Theo phòng ban và trạng thái hồ sơ</div></div><div class="overview-employee-controls px-3"><div class="btn-group flex-wrap mb-2" role="group" aria-label="Chế độ biểu đồ nhân viên"><button class="btn btn-sm" type="button" data-employee-mode="all" aria-pressed="false">Tất cả phòng ban</button><button class="btn btn-sm btn-primary" type="button" data-employee-mode="division" aria-pressed="true">Theo khối</button><button class="btn btn-sm" type="button" data-employee-mode="detail" aria-pressed="false">Chi tiết khối</button></div><div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2"><span id="employee-breadcrumb" class="text-secondary" role="status" aria-live="polite">Tổng quan / Theo khối</span><button id="employee-back" type="button" class="btn btn-sm" hidden>Quay lại các khối</button></div><label for="employee-division" class="visually-hidden">Chọn khối để xem phòng ban</label><select id="employee-division" class="form-select" hidden disabled><option>Đang tải các khối…</option></select><div class="form-hint mt-2">Ở chế độ Theo khối, bấm cột hoặc tên khối để xem phòng ban. Có thể cuộn ngang để xem toàn bộ cột.</div></div><div class="employee-chart-scroll" tabindex="0" role="region" aria-label="Biểu đồ nhân viên, cuộn ngang để xem tất cả phòng ban"><div id="employee-chart" class="overview-chart" role="img" aria-label="Biểu đồ nhân viên theo phòng ban"></div></div></div><div class="card"><div class="card-header"><h2 class="card-title">Cơ cấu chất lượng hồ sơ</h2></div><div id="distribution-chart" class="overview-chart" role="img" aria-label="Biểu đồ phân bố chất lượng hồ sơ"></div></div></div>
<div class="card dashboard-documents"><div class="card-header"><h2 class="card-title">Tổng tài liệu theo loại và trạng thái</h2></div><div class="dashboard-chart-viewport" tabindex="0" role="region" aria-label="Biểu đồ, cuộn để xem toàn bộ hạng mục"><div id="document-chart" class="overview-chart wide-chart" role="img" aria-label="Biểu đồ tài liệu theo loại và trạng thái"></div></div></div>
</div>
<details class="mb-3"><summary>Xem dữ liệu biểu đồ dạng bảng</summary><div id="accessible-chart-data" class="table-responsive mt-2"></div></details>
</div>
<div class="card"><div class="card-header flex-wrap gap-3"><h2 class="card-title">Danh sách nhân viên cần bổ sung hồ sơ</h2><form id="missing-search" class="ms-auto d-flex gap-2"><label class="visually-hidden" for="search-missing">Tìm mã, họ tên, phòng ban</label><input id="search-missing" maxlength="100" class="form-control" placeholder="Mã, họ tên, phòng ban" /><button type="submit" class="btn">Tìm</button></form></div><div id="missing-error" class="alert alert-danger m-3" hidden role="alert"></div><div class="table-responsive"><table class="table table-vcenter overview-table"><thead><tr>@foreach(var c in new[]{("id","Mã nhân viên"),("name","Họ tên"),("department","Phòng ban"),("required","Tổng yêu cầu"),("present","Hiện có"),("missing","Thiếu"),("issue","Nguyên nhân"),("codes","Loại tài liệu thiếu")}){<th scope="col" aria-sort="@(c.Item1=="missing"?"descending":"none")"><button type="button" class="table-sort-button" data-sort="@c.Item1">@c.Item2</button></th>}</tr></thead><tbody id="missing-rows"><tr><td colspan="8">Đang tải…</td></tr></tbody></table></div><div class="card-footer d-flex justify-content-between align-items-center flex-wrap gap-2"><span id="missing-page" aria-live="polite"></span><div class="d-flex gap-2 align-items-center"><label class="visually-hidden" for="page-size">Số dòng mỗi trang</label><select id="page-size" class="form-select"><option>20</option><option>50</option><option>100</option></select><button id="previous-page" type="button" class="btn" disabled>Trước</button><button id="next-page" type="button" class="btn" disabled>Sau</button></div></div></div>
</section>
@section Scripts {<script src="~/lib/echarts/echarts.min.js" asp-append-version="true"></script><script src="~/js/dashboard-multiselect.js" asp-append-version="true"></script><script src="~/js/employee-hierarchy.js" asp-append-version="true"></script><script src="~/js/overview-layout.js" asp-append-version="true"></script><script src="~/js/dashboard.js" asp-append-version="true"></script>}



