@{ ViewData["Title"]="Báo cáo trực quan"; }
<link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
<section id="executive-overview" data-overview-url="@Url.Action("Data")" data-options-url="@Url.Action("Options")" data-missing-url="@Url.Action("Missing")" data-drill-url="@Url.Action("DocumentDetails")">
<div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-3"><div><h1 class="page-title">Báo cáo trực quan</h1></div><button class="btn btn-outline-primary" id="refresh-overview" type="button">Làm mới</button></div>
<partial name="_ReportTabs" />
<div class="card mb-3"><div class="card-body"><form id="overview-filters"><div class="row g-3 align-items-end">
<div class="col-12 col-md-4"><label for="status-filter" class="form-label">Trạng thái làm việc</label><select id="status-filter" name="Statuses" multiple class="form-select" data-multi-filter data-placeholder="Tất cả trạng thái"><option value="DangLamViec" selected>@Vtb.Hr.Web.Services.Labels.Text("DangLamViec")</option><option value="TamHoanHDLD" selected>@Vtb.Hr.Web.Services.Labels.Text("TamHoanHDLD")</option></select></div>
<div class="col-12 col-md-3"><label for="division-filter" class="form-label">Khối</label><select id="division-filter" name="DivisionIds" multiple class="form-select" data-multi-filter data-placeholder="Chọn khối"></select></div>
<div class="col-12 col-md-3"><label for="department-filter" class="form-label">Phòng ban</label><select id="department-filter" name="DepartmentIds" multiple class="form-select" data-multi-filter data-placeholder="Chọn phòng ban"></select></div>
<div class="col-12 col-md-2"><button type="button" id="clear-filters" class="btn w-100">Xóa bộ lọc</button></div>
</div><div class="form-hint mt-2"></div></form></div></div>
<div id="overview-error" class="alert alert-danger" role="alert" hidden></div><div id="overview-status" class="text-secondary mb-3" role="status" aria-live="polite">Đang tải dữ liệu…</div>
<div id="overview-results" aria-busy="true">
<div class="dashboard-kpi-grid">
@foreach(var k in new[]{("totalEmployees","Tổng cán bộ","total"),("completenessRate","Tỷ lệ cán bộ đủ hồ sơ","complete"),("missingEmployees","Cán bộ thiếu hồ sơ","missing"),("expiringDocuments","Tài liệu sắp hết hạn","expiring"),("expiredDocuments","Tài liệu đã hết hạn","expired"),("invalidDocuments","Tài liệu không hợp lệ","invalid")})
{
    <div class="dashboard-kpi-card">
        <div class="dashboard-kpi-label">@k.Item2</div>
        <div class="dashboard-kpi-value dashboard-kpi-value--@k.Item3" data-kpi="@k.Item1">—</div>
    </div>
}
</div>
<div class="dashboard-overview-layout">
<div class="dashboard-overview-left"><div class="card"><div class="card-header d-block"><div class="chart-drill-toolbar"><h2 class="card-title" id="employee-chart-title">Tổng cán bộ</h2></div></div><div class="overview-employee-controls chart-controls"><div class="chart-mode-buttons" role="group" aria-label="Chế độ biểu đồ cán bộ"><button class="btn btn-sm" type="button" data-employee-mode="all" aria-pressed="false">Tất cả phòng ban</button><button class="btn btn-sm btn-primary" type="button" data-employee-mode="division" aria-pressed="true">Theo khối</button><button class="btn btn-sm" type="button" data-employee-mode="detail" aria-pressed="false">Chi tiết khối</button></div><label for="employee-division" class="visually-hidden">Chọn khối để xem phòng ban</label><select id="employee-division" class="form-select" hidden disabled><option>Đang tải các khối…</option></select><button id="employee-back" type="button" class="btn btn-sm btn-outline-secondary chart-drill-back" hidden><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M5 12l6 6M5 12l6 -6"/></svg><span>Quay lại</span></button></div><div class="employee-chart-scroll" tabindex="0" role="region" aria-label="Biểu đồ cán bộ, cuộn ngang để xem tất cả phòng ban"><div id="employee-chart" class="overview-chart" role="img" aria-label="Biểu đồ cán bộ theo phòng ban"></div></div></div><div class="card"><div class="card-header"><h2 class="card-title">Cơ cấu chất lượng hồ sơ</h2></div><div id="distribution-chart" class="overview-chart" role="img" aria-label="Biểu đồ phân bố chất lượng hồ sơ"></div></div></div>
<div class="card dashboard-documents"><div class="card-header d-block"><div class="chart-drill-toolbar"><h2 class="card-title" id="document-chart-title">Tổng tài liệu theo loại và trạng thái</h2></div></div><div class="overview-document-controls chart-controls"><div class="chart-mode-buttons" role="group" aria-label="Chế độ biểu đồ tài liệu"><button class="btn btn-sm btn-primary" type="button" data-document-mode="all" aria-pressed="true">Tất cả loại tài liệu</button><button class="btn btn-sm" type="button" data-document-mode="group" aria-pressed="false">Theo nhóm</button><button class="btn btn-sm" type="button" data-document-mode="detail" aria-pressed="false">Chi tiết nhóm</button></div><label for="document-group" class="visually-hidden">Chọn nhóm hồ sơ</label><select id="document-group" class="form-select" hidden disabled></select><button id="document-group-back" type="button" class="btn btn-sm btn-outline-secondary chart-drill-back" hidden><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M5 12l6 6M5 12l6 -6"/></svg><span>Quay lại</span></button></div><div class="dashboard-chart-viewport" tabindex="0" role="region" aria-label="Biểu đồ, cuộn để xem toàn bộ hạng mục"><div id="document-chart" class="overview-chart wide-chart" role="img" aria-label="Biểu đồ tài liệu theo loại và trạng thái"></div></div></div>
</div>
<details class="mb-3"><summary>Xem dữ liệu biểu đồ dạng bảng</summary><div id="accessible-chart-data" class="table-responsive mt-2"></div></details>
</div>
<div class="card"><div class="card-header dashboard-table-header d-flex justify-content-between align-items-center flex-wrap gap-3"><h2 class="card-title">Danh sách cán bộ cần bổ sung hoặc xử lý hồ sơ</h2><div class="dashboard-table-tools d-flex align-items-end justify-content-end flex-wrap gap-3"><form id="missing-search" class="dashboard-table-search d-flex align-items-end gap-2"><div class="ui-table-search-field"><label class="form-label" for="search-missing">Tìm mã, họ tên, phòng ban</label><input id="search-missing" maxlength="100" class="form-control" placeholder="Mã, họ tên, phòng ban" /></div><button type="submit" class="btn btn-primary">Tìm</button></form></div></div><div id="missing-error" class="alert alert-danger m-3" hidden role="alert"></div><div class="table-responsive"><table class="table table-vcenter overview-table followup-employee-table"><thead><tr>@foreach(var c in new[]{("id","Mã cán bộ"),("name","Họ tên"),("department","Phòng ban"),("missing","Số tài liệu thiếu"),("issue","Vấn đề cần xử lý"),("codes","Tài liệu cần bổ sung")}){<th scope="col" class="@(c.Item1=="missing"?"ui-number":null)" aria-sort="@(c.Item1=="missing"?"descending":"none")"><button type="button" class="table-sort-button" data-sort="@c.Item1">@c.Item2</button></th>}</tr></thead><tbody id="missing-rows"><tr><td colspan="6">Đang tải…</td></tr></tbody></table></div><div class="card-footer d-flex justify-content-between align-items-center flex-wrap gap-2"><span id="missing-page" aria-live="polite"></span><div class="d-flex gap-2 align-items-center"><label class="visually-hidden" for="page-size">Số dòng mỗi trang</label><select id="page-size" class="form-select"><option>20</option><option>50</option><option>100</option></select><button id="previous-page" type="button" class="btn" disabled>Trước</button><button id="next-page" type="button" class="btn" disabled>Sau</button></div></div></div>
</section>
@section Scripts {<script src="~/lib/echarts/echarts.min.js" asp-append-version="true"></script><script src="~/js/donut-total.js" asp-append-version="true"></script><script src="~/js/dashboard-multiselect.js" asp-append-version="true"></script><script src="~/js/employee-hierarchy.js" asp-append-version="true"></script><script src="~/js/overview-layout.js" asp-append-version="true"></script><script src="~/js/document-types.js" asp-append-version="true"></script><script src="~/js/dashboard.js" asp-append-version="true"></script>}



