@{ViewData["Title"]="Hợp đồng lao động";}
<link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/reports.css" asp-append-version="true"/>
<section class="secondary-report" id="secondary-report" data-report="contract" data-api="@Url.Action("ContractData")" data-options="@Url.Action("ReportOptions")" data-table="@Url.Action("ReportTable")" data-drill="@Url.Action("ContractDetails")">
<h1 class="page-title mb-2">Theo dõi Hợp đồng lao động</h1><p class="text-secondary">Bao gồm toàn bộ tài liệu liên quan đến HĐLĐ của cán bộ Đang làm việc và Tạm hoãn HĐLĐ.</p><partial name="_ReportTabs"/><partial name="_ReportFilters" model='@("contract")'/>
<div id="report-error" class="alert alert-danger" hidden role="alert"></div><div id="report-status" class="text-secondary mb-3" role="status"></div>
<div class="dashboard-kpi-grid report-kpis">
@foreach(var k in new[]{("valid","Cán bộ có HĐLĐ hợp lệ","complete"),("next","Cán bộ có HĐ cần ký tiếp","missing"),("missing","Cán bộ thiếu HĐXĐTH1","missing"),("expiring","Hợp đồng sắp hết hạn","expiring")}){<div class="dashboard-kpi-card"><div class="dashboard-kpi-label">@k.Item2</div><div class="dashboard-kpi-value dashboard-kpi-value--@k.Item3" data-report-kpi="@k.Item1">—</div></div>}
</div>
<div class="report-charts-grid">
<div class="card report-chart-card"><div class="card-header"><h2 class="card-title">Tổng cán bộ theo trạng thái hợp đồng</h2></div><div class="dashboard-chart-viewport" tabindex="0" role="region" aria-label="Tổng cán bộ theo trạng thái hợp đồng"><div id="report-chart-second" class="overview-chart" role="img" aria-label="Tổng cán bộ theo trạng thái hợp đồng"></div></div><details class="contract-drill-actions"><summary>Xem chi tiết theo trạng thái</summary><div id="contract-links" class="card-body d-flex flex-wrap gap-2"></div></details></div>
<div class="card report-chart-card"><div class="card-header"><div class="chart-drill-toolbar"><h2 class="card-title" id="contract-org-title">Cán bộ cần xử lý hợp đồng</h2></div></div><div class="chart-controls">
<div class="chart-mode-buttons" role="group" aria-label="Chế độ cán bộ cần xử lý">
<button id="contract-mode-all" type="button" class="btn btn-sm" aria-pressed="false">Tất cả phòng ban</button>
<button id="contract-mode-division" type="button" class="btn btn-sm btn-primary" aria-pressed="true">Theo khối</button>
<button id="contract-mode-detail" type="button" class="btn btn-sm" aria-pressed="false">Chi tiết khối</button></div>
<label id="contract-division-label" class="chart-picker" hidden><span class="visually-hidden">Chọn khối</span><select id="contract-division" class="form-select form-select-sm" aria-label="Chọn khối"></select></label>
<button id="contract-org-back" type="button" class="btn btn-sm btn-outline-secondary chart-drill-back" hidden><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M5 12l6 6M5 12l6 -6"/></svg><span>Quay lại</span></button></div><div class="dashboard-chart-viewport" tabindex="0" role="region" aria-label="Cán bộ cần xử lý hợp đồng"><div id="report-chart-first" class="overview-chart" role="img" aria-label="Cán bộ cần xử lý hợp đồng"></div></div></div>
</div>
<section class="card contract-table-tabs" aria-labelledby="contract-tables-title">
<div class="card-header"><h2 class="card-title" id="contract-tables-title">Danh sách hợp đồng cần theo dõi</h2></div>
<div class="nav nav-tabs px-3" role="tablist" aria-label="Danh sách hợp đồng">
<button type="button" class="nav-link active" id="contractIssues-tab" role="tab" aria-selected="true" aria-controls="contractIssues-panel">Cán bộ cần xử lý</button>
<button type="button" class="nav-link" id="expiredContracts-tab" role="tab" aria-selected="false" aria-controls="expiredContracts-panel" tabindex="-1">Hợp đồng đã hết hạn</button></div>
<div id="contractIssues-panel" role="tabpanel" aria-labelledby="contractIssues-tab"><partial name="_ReportTables" model='@("contractIssues")'/></div>
<div id="expiredContracts-panel" role="tabpanel" aria-labelledby="expiredContracts-tab" hidden><partial name="_ReportTables" model='@("expiredContracts")'/></div></section>

</section>
@section Scripts{<script src="~/lib/echarts/echarts.min.js" asp-append-version="true"></script><script src="~/js/donut-total.js" asp-append-version="true"></script><script src="~/js/contract-report.js" asp-append-version="true"></script><script src="~/js/reports.js" asp-append-version="true"></script>}
