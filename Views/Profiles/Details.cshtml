@model ProfileModel
@using Vtb.Hr.Web.Services
@using Vtb.Hr.Web.Security
@inject IConfiguration Config
@{ViewData["Title"]="Hồ sơ · "+Model.Employee.FullName;var admin=Access.Admin(User,Config);}
<link rel="stylesheet" href="~/css/profile.css" asp-append-version="true" />
<section class="employee-profile">
<div class="page-header mb-4"><h1 class="page-title">@Model.Employee.FullName</h1><p class="text-secondary mt-2">@Model.Employee.EmployeeId · @Model.Department.DepartmentName · @Model.Department.Division.DivisionName</p></div>
<div class="mb-3"><a class="btn btn-outline-primary" asp-action="Print" asp-route-id="@Model.Employee.EmployeeId">In lý lịch trích ngang</a></div>
<div class="row row-cards mb-4"><div class="col-lg-5"><div class="card h-100"><div class="card-body"><h2 class="card-title">Thông tin cá nhân</h2><dl class="row"><dt class="col-5">Ngày sinh</dt><dd class="col-7">@QualityService.Date(Model.Employee.DateOfBirth)</dd><dt class="col-5">Giới tính</dt><dd class="col-7">@Labels.Text(Model.Employee.Gender)</dd><dt class="col-5">Số điện thoại</dt><dd class="col-7 text-break">@ProfilePresentation.Text(Model.Employee.PhoneNumber)</dd><dt class="col-5">Email</dt><dd class="col-7 text-break">@ProfilePresentation.Text(Model.Employee.Email)</dd><dt class="col-5">Quê quán</dt><dd class="col-7 text-break">@ProfilePresentation.Text(Model.Employee.Hometown)</dd><dt class="col-5">Chức danh</dt><dd class="col-7">@Model.Employee.PositionName</dd><dt class="col-5">Quản lý</dt><dd class="col-7">@(Model.Employee.IsManagerial?"Có":"Không")</dd><dt class="col-5">Trạng thái</dt><dd class="col-7"><span class="badge bg-@ProfilePresentation.EmploymentColor(Model.Employee.EmploymentStatus)-lt">@ProfilePresentation.EmploymentLabel(Model.Employee.EmploymentStatus)</span></dd><dt class="col-5">Ngày vào / nghỉ</dt><dd class="col-7">@QualityService.Date(Model.Employee.JoinDate) / @QualityService.Date(Model.Employee.LeaveDate)</dd></dl>@if(admin){<a class="btn btn-outline-primary" asp-controller="Catalog" asp-action="Edit" asp-route-kind="employees" asp-route-id="@Model.Employee.EmployeeId">Sửa thông tin</a>}</div></div></div>
<div class="col-lg-7"><div class="card h-100"><div class="card-body"><h2 class="card-title">Chất lượng hồ sơ</h2>@if(Model.Quality is {} q){<span class="profile-status profile-status--@ProfilePresentation.StateClass(q.EmployeeQualityStatus)">@Labels.Text(q.EmployeeQualityStatus)</span><div class="row mt-4"><div class="col">Yêu cầu<strong class="d-block h1">@q.TotalRequiredDocuments</strong></div><div class="col">Đã có<strong class="d-block h1">@q.TotalDocumentsPresent</strong></div><div class="col">Còn thiếu<strong class="d-block h1 text-red">@q.TotalDocumentsMissing</strong></div></div><p>@q.QualityIssue</p>}else{<p>Chưa có kết quả đánh giá trong View.</p>}<p>Hợp đồng: <strong>@Labels.Text(Model.Contract?.LaborContractStatus)</strong></p></div></div></div></div>
<partial name="~/Views/Profiles/_Qualifications.cshtml" model="Model" />
<div class="card mb-4"><div class="card-header"><h2 class="card-title">Hồ sơ còn thiếu</h2></div><div class="card-body">@if(Model.Missing.Count==0){<p class="text-secondary"></p>}@foreach(var item in Model.Missing){<div class="d-flex justify-content-between border-bottom py-3 gap-3"><div><strong>@item.DocumentName</strong> <span class="profile-status profile-status--missing">Thiếu hồ sơ</span>@if(!string.IsNullOrWhiteSpace(item.RequirementReason)){<div class="text-secondary">@item.RequirementReason</div>}</div>@if(admin){<a class="btn btn-sm btn-primary align-self-center" asp-controller="Catalog" asp-action="Create" asp-route-kind="documents" asp-route-employeeId="@Model.Employee.EmployeeId" asp-route-documentTypeId="@item.DocumentTypeId">Bổ sung</a>}</div>}</div></div>
<partial name="~/Views/Profiles/_DocumentWarnings.cshtml" model="Model" />
<partial name="~/Views/Profiles/_DocumentGroups.cshtml" model="Model" />
</section>
