@model ProfileModel
@using Vtb.Hr.Web.Services
@using Vtb.Hr.Web.Security
@inject IConfiguration Config
@{
    ViewData["Title"] = "Hồ sơ · " + Model.Employee.FullName;
    var admin = Access.Admin(User, Config);
    string WorkDate(DateOnly? date) => date is {} value && value != default(DateOnly)
        ? value.ToString("dd/MM/yyyy", System.Globalization.CultureInfo.InvariantCulture)
        : "--";
    var joinDateText = WorkDate(Model.Employee.JoinDate);
    var leaveDateText = Model.Employee.LeaveDate.HasValue
        ? WorkDate(Model.Employee.LeaveDate)
        : Model.Employee.EmploymentStatus == "DangLamViec" ? "Nay" : "--";
}
<link rel="stylesheet" href="~/css/profile.css" asp-append-version="true" />
<section class="employee-profile">
<div class="page-header mb-4"><h1 class="page-title">@Model.Employee.FullName</h1><p class="text-secondary mt-2">@Model.Employee.EmployeeId · @Model.Department.DepartmentName · @Model.Department.Division.DivisionName</p></div>
<div class="mb-3"><a class="btn me-2" href="@(NavigationContext.Return(Context.Request)??Url.Action("Index","Catalog",new{kind="employees"}))">Quay lại danh sách / báo cáo</a><a class="btn btn-outline-primary" asp-action="Print" asp-route-id="@Model.Employee.EmployeeId">In lý lịch trích ngang</a></div>
<div class="row row-cards mb-4"><div class="col-lg-5"><div class="card h-100"><div class="card-body"><h2 class="card-title">Thông tin cá nhân</h2><dl class="row"><dt class="col-5">Ngày sinh</dt><dd class="col-7">@QualityService.Date(Model.Employee.DateOfBirth)</dd><dt class="col-5">Giới tính</dt><dd class="col-7">@Labels.Text(Model.Employee.Gender)</dd><dt class="col-5">Số điện thoại</dt><dd class="col-7 text-break">@ProfilePresentation.Text(Model.Employee.PhoneNumber)</dd><dt class="col-5">Email</dt><dd class="col-7 text-break">@ProfilePresentation.Text(Model.Employee.Email)</dd><dt class="col-5">Quê quán</dt><dd class="col-7 text-break">@ProfilePresentation.Text(Model.Employee.Hometown)</dd><dt class="col-5">Chức danh</dt><dd class="col-7">@Model.Employee.PositionName</dd><dt class="col-5">Quản lý</dt><dd class="col-7">@(Model.Employee.IsManagerial?"Có":"Không")</dd><dt class="col-5">Trạng thái</dt><dd class="col-7"><span class="badge bg-@ProfilePresentation.EmploymentColor(Model.Employee.EmploymentStatus)-lt">@ProfilePresentation.EmploymentLabel(Model.Employee.EmploymentStatus)</span></dd><dt class="col-5">Thời gian công tác</dt><dd class="col-7">@joinDateText - @leaveDateText</dd></dl>@if(admin){<a class="btn btn-outline-primary" asp-controller="Catalog" asp-action="Edit" asp-route-kind="employees" asp-route-id="@Model.Employee.EmployeeId" asp-route-returnUrl="@NavigationContext.Current(Context.Request)">Sửa thông tin</a>}</div></div></div>
<div class="col-lg-7"><div class="card h-100"><div class="card-body"><h2 class="card-title">Chất lượng hồ sơ</h2>@if(Model.Quality is {} q){<span class="profile-status profile-status--@(q.EmploymentStatus=="ChamDutHDLD"?"unknown":ProfilePresentation.StateClass(q.EmployeeQualityStatus))">@EmployeeQualityIndicators.FromQuality(q).Label</span><div class="row mt-4"><div class="col">Yêu cầu<strong class="d-block h1">@q.TotalRequiredDocuments</strong></div><div class="col">Đã có<strong class="d-block h1">@q.TotalDocumentsPresent</strong></div><div class="col">Còn thiếu<strong class="d-block h1 text-red">@q.TotalDocumentsMissing</strong></div></div><p class="mt-3">@q.QualityIssue</p><p>Mã loại tài liệu còn thiếu: <strong>@ProfilePresentation.Text(q.MissingDocumentCodes)</strong></p>}else{<p>Chưa có kết quả đánh giá hồ sơ.</p>}<p>Hợp đồng: <strong>@(ProfilePresentation.ReceivesCurrentWarnings(Model)?Labels.Text(Model.Quality?.LaborContractStatus):"Không áp dụng cảnh báo hiện hành")</strong></p></div></div></div></div>
<partial name="~/Views/Profiles/_Qualifications.cshtml" model="Model" />
<div class="card mb-4"><div class="card-header"><h2 class="card-title">Hồ sơ còn thiếu</h2></div><div class="card-body">@if(Model.Missing.Count==0){<p class="text-secondary">@(Model.Quality==null?"Chưa có kết quả đánh giá hồ sơ của cán bộ. Hiện không có mục hồ sơ thiếu được trả về; chưa thể kết luận hồ sơ đầy đủ hoặc hợp lệ.":Model.Employee.EmploymentStatus=="ChamDutHDLD"?"Không áp dụng đánh giá hồ sơ bắt buộc cho cán bộ đã chấm dứt HĐLĐ.":"Không có mục hồ sơ thiếu trong kết quả hiện tại. Điều này không đồng nghĩa mọi tài liệu hoặc hợp đồng đều hợp lệ; xem phần chất lượng và cảnh báo bên dưới.")</p>}@foreach(var item in Model.Missing){<div class="d-flex justify-content-between border-bottom py-3 gap-3"><div><strong>@item.DocumentName</strong> <span class="profile-status profile-status--missing">Thiếu hồ sơ</span>@if(!string.IsNullOrWhiteSpace(item.RequirementReason)){<div class="text-secondary">@item.RequirementReason</div>}</div>@if(admin){<a class="btn btn-sm btn-primary align-self-center" asp-controller="Catalog" asp-action="Create" asp-route-kind="documents" asp-route-employeeId="@Model.Employee.EmployeeId" asp-route-documentTypeId="@item.DocumentTypeId" asp-route-returnUrl="@NavigationContext.Current(Context.Request)">Bổ sung</a>}</div>}</div></div>
<partial name="~/Views/Profiles/_DocumentWarnings.cshtml" model="Model" />
<partial name="~/Views/Profiles/_DocumentGroups.cshtml" model="Model" />
</section>
