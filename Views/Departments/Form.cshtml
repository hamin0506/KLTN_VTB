@model DepartmentForm
@{bool edit=Model.DepartmentId>0;ViewData["Title"]=edit?"Chỉnh sửa phòng ban":"Thêm phòng ban";}
<h1 class="page-title mb-4">@ViewData["Title"]</h1><div class="row row-cards"><div class="col-lg-8"><form class="card" asp-action="@(edit?"Edit":"Create")" asp-route-id="@(edit?Model.DepartmentId:(int?)null)" method="post"><div class="card-header"><h3 class="card-title">Thông tin phòng ban</h3></div><div class="card-body"><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><input asp-for="DepartmentId" type="hidden"/>
@if(Model.Divisions.Count == 0){<div class="alert alert-warning">Chưa có đơn vị trực thuộc. <a asp-controller="Divisions" asp-action="Create">Thêm đơn vị trước</a> để tạo phòng ban.</div>}
<div class="mb-4"><label asp-for="DivisionId" class="form-label required"></label><select asp-for="DivisionId" asp-items="Model.Divisions" class="form-select"><option value="0">— Chọn đơn vị trực thuộc —</option></select><span asp-validation-for="DivisionId" class="text-danger"></span></div><div class="mb-4"><label asp-for="DepartmentCode" class="form-label required"></label><input asp-for="DepartmentCode" class="form-control" maxlength="20" placeholder="Ví dụ: P_HCNS"/><span asp-validation-for="DepartmentCode" class="text-danger"></span><div class="form-hint">Tối đa 20 ký tự ASCII, không chứa khoảng trắng.</div></div><div class="mb-3"><label asp-for="DepartmentName" class="form-label required"></label><input asp-for="DepartmentName" class="form-control" maxlength="200" placeholder="Nhập tên đầy đủ của phòng ban"/><span asp-validation-for="DepartmentName" class="text-danger"></span></div></div><div class="card-footer text-end"><a class="btn me-2" asp-action="Index">Hủy</a><button type="submit" class="btn btn-primary">Lưu phòng ban</button></div></form></div></div>
@section Scripts{<partial name="_ValidationScriptsPartial"/>}
