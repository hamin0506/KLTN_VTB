@using Vtb.Hr.Web.Services
@model DepartmentForm
@{bool edit=Model.DepartmentId>0;ViewData["Title"]=edit?"Chỉnh sửa phòng ban":"Thêm phòng ban";}
<h1 class="page-title mb-4">@ViewData["Title"]</h1><div class="row row-cards"><div class="col-lg-8"><form class="card ui-form" asp-action="@(edit?"Edit":"Create")" asp-route-id="@(edit?Model.DepartmentId:(int?)null)" method="post"><input type="hidden" name="returnUrl" value="@NavigationContext.OrganizationReturn(Context.Request, "Departments")"/><div class="card-header"><h3 class="card-title">Thông tin phòng ban</h3></div><div class="card-body"><p class="form-hint mb-3">Các trường có dấu * là bắt buộc.</p><div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert" tabindex="-1"></div><input asp-for="DepartmentId" type="hidden"/>
@if(Model.Divisions.Count == 0){<div class="alert alert-warning">Chưa có khối trực thuộc. <a asp-controller="Divisions" asp-action="Create">Thêm khối trước</a> để tạo phòng ban.</div>}
<div class="mb-4"><label asp-for="DivisionId" class="form-label required"></label><select asp-for="DivisionId" asp-items="Model.Divisions" class="form-select"><option value="0">— Chọn khối trực thuộc —</option></select><span asp-validation-for="DivisionId" class="text-danger"></span></div><div class="mb-4"><label asp-for="DepartmentCode" class="form-label required"></label><input asp-for="DepartmentCode" class="form-control" maxlength="20" placeholder="Ví dụ: P_HCNS"/><span asp-validation-for="DepartmentCode" class="text-danger"></span><div class="form-hint">Tối đa 20 ký tự ASCII, không chứa khoảng trắng.</div></div><div class="mb-3"><label asp-for="DepartmentName" class="form-label required"></label><input asp-for="DepartmentName" class="form-control" maxlength="200" placeholder="Nhập tên đầy đủ của phòng ban"/><span asp-validation-for="DepartmentName" class="text-danger"></span></div></div><div class="card-footer ui-form-actions"><a class="btn btn-outline-secondary" href="@(NavigationContext.OrganizationReturn(Context.Request,"Departments")??Url.Action("Index","Departments"))">Hủy</a><button type="submit" class="btn btn-primary">Lưu</button></div></form></div></div>
@section Scripts{<partial name="_ValidationScriptsPartial"/>}
