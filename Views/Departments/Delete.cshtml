@model Vtb.Hr.Web.Data.Department
@{ViewData["Title"]="Xác nhận xóa phòng ban";}
<h1 class="page-title mb-4">Xác nhận xóa phòng ban</h1><div class="card"><div class="card-body"><div class="alert alert-warning">Thao tác xóa không thể hoàn tác. Phòng ban có cán bộ trực thuộc sẽ không được xóa.</div><h2>@Model.DepartmentName</h2><p class="text-secondary">Mã phòng ban: @Model.DepartmentCode · Đơn vị: @Model.Division.DivisionName</p></div><form class="card-footer text-end" asp-action="Delete" asp-route-id="@Model.DepartmentId" method="post"><a class="btn me-2" asp-action="Index">Hủy</a><button class="btn btn-danger" type="submit">Xác nhận xóa</button></form></div>
