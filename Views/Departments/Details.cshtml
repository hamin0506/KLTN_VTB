@model Vtb.Hr.Web.Data.Department
@{ViewData["Title"]="Chi tiết phòng ban";}
<h1 class="page-title mb-4">@Model.DepartmentName</h1><div class="card"><div class="card-body"><dl class="row"><dt class="col-sm-3">Mã định danh</dt><dd class="col-sm-9">@Model.DepartmentId</dd><dt class="col-sm-3">Mã phòng ban</dt><dd class="col-sm-9">@Model.DepartmentCode</dd><dt class="col-sm-3">Tên phòng ban</dt><dd class="col-sm-9">@Model.DepartmentName</dd><dt class="col-sm-3">Đơn vị trực thuộc</dt><dd class="col-sm-9">@Model.Division.DivisionName</dd></dl></div><div class="card-footer"><a class="btn" asp-action="Index">Quay lại</a> <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.DepartmentId">Chỉnh sửa</a></div></div>
