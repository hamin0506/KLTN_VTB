@model DepartmentList
@using Vtb.Hr.Web.Security
@using Vtb.Hr.Web.Services
@inject IConfiguration Config
@{var admin=Access.Admin(User,Config);var hasFilters=!string.IsNullOrWhiteSpace(Model.Q)||Model.DivisionId.HasValue;ViewData["Title"]="Phòng ban";}
<div class="page-header mb-4"><div class="row align-items-center"><div class="col"><h1 class="page-title">Phòng ban</h1></div><div class="col-auto">@if(admin){<a class="btn btn-primary" asp-action="Create" asp-route-returnUrl="@NavigationContext.Current(Context.Request)">+ Thêm phòng ban</a>}</div></div></div>
<div class="card"><div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-3 export-card-header"><h3 class="card-title">Danh sách phòng ban</h3><div class="export-header-actions d-flex align-items-center justify-content-end flex-wrap gap-2 ms-auto"><button type="button" class="btn btn-sm btn-outline-primary export-button" data-export-url="@Url.Action("Organization","Export",new{kind="departments",q=Model.Q , divisionId=Model.DivisionId})">Xuất Excel</button><span class="badge bg-blue-lt">@Model.Total dòng</span></div></div><div class="card-body border-bottom"><form method="get" class="d-flex align-items-end gap-3 flex-wrap"><div class="ui-filter-field"><label for="q" class="form-label">Tìm mã hoặc tên phòng ban</label><input class="form-control" id="q" name="q" value="@Model.Q" placeholder="Tìm mã, tên hoặc khối…" maxlength="200"/></div><div class="ui-filter-field"><label for="divisionId" class="form-label">Khối</label><select id="divisionId" name="divisionId" class="form-select"><option value="">Tất cả khối</option>@foreach(var option in Model.Divisions){<option value="@option.Value" selected="@(option.Value==Model.DivisionId?.ToString())">@option.Text</option>}</select></div><button class="btn btn-primary" type="submit">Áp dụng</button>@if(hasFilters){<a class="btn btn-outline-secondary" asp-action="Index">Xóa bộ lọc</a>}</form></div>
@if(Model.Items.Count==0){<div class="text-center p-5"><div class="empty-icon">▦</div><h3 class="mt-3">@(hasFilters?"Không tìm thấy phòng ban trong phạm vi đã chọn":"Chưa có phòng ban")</h3><p class="text-secondary">@(hasFilters?"Thử thay đổi khối, từ khóa hoặc chọn Xóa bộ lọc.":admin?"Bạn có thể thêm phòng ban mới.":"Liên hệ người quản trị nếu cần bổ sung phòng ban.")</p></div>}else{<div class="table-responsive"><table class="table table-vcenter mb-0"><thead><tr><th>Mã phòng ban</th><th>Tên phòng ban</th><th>Khối trực thuộc</th><th class="text-end">Thao tác</th></tr></thead><tbody>@foreach(var item in Model.Items){<tr><td><span class="badge bg-blue-lt">@item.DepartmentCode</span></td><td><a class="fw-semibold" asp-action="Details" asp-route-returnUrl="@NavigationContext.Current(Context.Request)" asp-route-id="@item.DepartmentId">@item.DepartmentName</a></td><td>@item.Division.DivisionName</td><td class="text-end"><div class="table-row-actions">@if(admin){<a asp-action="Edit" asp-route-returnUrl="@NavigationContext.Current(Context.Request)" asp-route-id="@item.DepartmentId">Chỉnh sửa</a>} @if(admin){<a class="text-danger" asp-action="Delete" asp-route-id="@item.DepartmentId">Xóa</a>}</div></td></tr>}</tbody></table></div>}
<div class="card-footer d-flex justify-content-between align-items-center"><span class="text-secondary">Trang @Model.Page / @Model.Pages · @Model.Total phòng ban</span><div class="btn-group">@if(Model.Page>1){<a class="btn" asp-route-page="@(Model.Page-1)" asp-route-q="@Model.Q" asp-route-divisionId="@Model.DivisionId">← Trước</a>}@if(Model.Page<Model.Pages){<a class="btn" asp-route-page="@(Model.Page+1)" asp-route-q="@Model.Q" asp-route-divisionId="@Model.DivisionId">Sau →</a>}</div></div></div>
