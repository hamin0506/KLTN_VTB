@model DepartmentList
@{ViewData["Title"]="Phòng ban";}
<div class="page-header mb-4"><div class="row align-items-center"><div class="col"><h1 class="page-title">Phòng ban</h1></div><div class="col-auto"><a class="btn btn-primary" asp-action="Create">+ Thêm phòng ban</a></div></div></div>
<div class="card"><div class="card-header flex-wrap gap-3"><h3 class="card-title">Danh sách phòng ban <span class="badge bg-blue-lt ms-2">@Model.Total</span></h3><form method="get" class="ms-auto d-flex gap-2 flex-wrap"><label for="q" class="visually-hidden">Tìm mã hoặc tên phòng ban</label><input class="form-control" id="q" name="q" value="@Model.Q" placeholder="Tìm mã, tên hoặc đơn vị…" maxlength="200"/><label for="divisionId" class="visually-hidden">Đơn vị</label><select id="divisionId" name="divisionId" class="form-select"><option value="">Tất cả đơn vị</option>@foreach(var option in Model.Divisions){<option value="@option.Value" selected="@(option.Value==Model.DivisionId?.ToString())">@option.Text</option>}</select><button class="btn btn-outline-primary" type="submit">Tìm kiếm</button>@if(!string.IsNullOrEmpty(Model.Q)){<a class="btn" asp-action="Index">Bỏ lọc</a>}</form></div>
@if(Model.Items.Count==0){<div class="text-center p-5"><div class="empty-icon">▦</div><h3 class="mt-3">@(string.IsNullOrEmpty(Model.Q)?"Chưa có phòng ban":"Không tìm thấy phòng ban")</h3><p class="text-secondary">Thêm phòng ban mới hoặc thử từ khóa tìm kiếm khác.</p></div>}else{<div class="table-responsive"><table class="table table-vcenter mb-0"><thead><tr><th>Mã phòng ban</th><th>Tên phòng ban</th><th>Đơn vị trực thuộc</th><th class="text-end">Thao tác</th></tr></thead><tbody>@foreach(var item in Model.Items){<tr><td><span class="badge bg-blue-lt">@item.DepartmentCode</span></td><td><a class="fw-semibold" asp-action="Details" asp-route-id="@item.DepartmentId">@item.DepartmentName</a></td><td>@item.Division.DivisionName</td><td class="text-end"><a class="btn btn-sm" asp-action="Edit" asp-route-id="@item.DepartmentId">Chỉnh sửa</a> <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.DepartmentId">Xóa</a></td></tr>}</tbody></table></div>}
<div class="card-footer d-flex justify-content-between align-items-center"><span class="text-secondary">Trang @Model.Page / @Model.Pages · @Model.Total phòng ban</span><div class="btn-group">@if(Model.Page>1){<a class="btn" asp-route-page="@(Model.Page-1)" asp-route-q="@Model.Q" asp-route-divisionId="@Model.DivisionId">← Trước</a>}@if(Model.Page<Model.Pages){<a class="btn" asp-route-page="@(Model.Page+1)" asp-route-q="@Model.Q" asp-route-divisionId="@Model.DivisionId">Sau →</a>}</div></div></div>
